# ── Core Accounting Backend — Environment Variables ──
# Copy to .env and fill in values before starting

# ── Database ──────────────────────────────────────────────────
# Primary (read/write) database — asyncpg driver
DATABASE_URL=postgresql+asyncpg://accounting:CHANGE_ME@localhost:5432/core_accounting
# AI read-only database connection (SELECT only, 5s timeout)
AI_READONLY_DATABASE_URL=postgresql+asyncpg://accounting_ro:CHANGE_ME@localhost:5432/core_accounting

# Connection pool settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT Authentication ────────────────────────────────────────
# Generate a strong secret: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_USE_A_STRONG_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── DeepSeek / LLM ────────────────────────────────────────────
# Get from https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-CHANGE_ME
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_FALLBACK_MODEL=deepseek-chat

# ── Aliyun OCR / 票据识别 ─────────────────────────────────────
# Get from https://ram.console.aliyun.com/manage/ak (grant OCR permissions).
# Leave empty to disable — 原始凭证「运行识别」falls back to the rule engine.
ALIYUN_OCR_ACCESS_KEY_ID=
ALIYUN_OCR_ACCESS_KEY_SECRET=
ALIYUN_OCR_ENDPOINT=ocr-api.cn-hangzhou.aliyuncs.com

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated in .env; parsed as JSON array by pydantic
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_GLOBAL=60/minute
RATE_LIMIT_AI=10/minute
RATE_LIMIT_AUTH=5/minute

# ── Application ───────────────────────────────────────────────
APP_NAME=Core Accounting
APP_VERSION=0.1.0
DEBUG=false
# 'development' (default) or 'production'. Production enables strict startup
# config validation (rejects default JWT_SECRET, placeholder DB password,
# localhost CORS). Leave as development for local runs.
ENVIRONMENT=development

# ── System ────────────────────────────────────────────────────
# System user UUID for automated operations (carry-forward, etc.)
SYSTEM_USER_ID=00000000-0000-0000-0000-000000000000
