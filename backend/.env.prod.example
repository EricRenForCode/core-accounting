# ── Core Accounting Backend — PRODUCTION Environment Template ──
# Docker Compose production reads the repository-root `.env`
# (copy from `/.env.example`, or run `./scripts/install.sh`).
# This file is the application-settings reference when the API runs
# outside Compose. NEVER commit a filled-in copy.
#
# Inside Compose, DATABASE_URL / AI_READONLY_DATABASE_URL / REDIS_URL / DEBUG /
# ENVIRONMENT are injected by docker-compose.prod.yml. The read-only role is
# created from DB_RO_USER / DB_RO_PASSWORD. Set the secrets below for a
# non-Compose process.
#
# Because ENVIRONMENT=production, startup validation (app/main.py) will REFUSE
# to boot if:
#   - JWT_SECRET is the default or shorter than 32 chars
#   - DATABASE_URL still contains "CHANGE_ME"
#   - CORS_ORIGINS still points at localhost

# ── JWT Authentication ────────────────────────────────────────
# REQUIRED. Generate a strong secret: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=1

# ── DeepSeek / LLM (optional — AI features) ───────────────────
# Get from https://platform.deepseek.com/api_keys. Leave placeholder to
# disable AI (a startup warning is logged, boot is not blocked).
DEEPSEEK_API_KEY=sk-CHANGE_ME
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_FALLBACK_MODEL=deepseek-chat

# ── Aliyun OCR / 票据识别 (optional) ───────────────────────────
# Get from https://ram.console.aliyun.com/manage/ak (grant OCR permissions).
# Leave empty to disable (a startup warning is logged, boot is not blocked).
ALIYUN_OCR_ACCESS_KEY_ID=
ALIYUN_OCR_ACCESS_KEY_SECRET=
ALIYUN_OCR_ENDPOINT=ocr-api.cn-hangzhou.aliyuncs.com

# ── CORS ──────────────────────────────────────────────────────
# REQUIRED. Your real frontend origin(s). JSON array, no localhost in prod.
CORS_ORIGINS=["https://accounting.example.com"]

# ── Connection pool (tune to your DB) ─────────────────────────
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_GLOBAL=60/minute
RATE_LIMIT_AI=10/minute
RATE_LIMIT_AUTH=5/minute

# ── Application ───────────────────────────────────────────────
APP_NAME=Core Accounting
APP_VERSION=0.1.0
# DEBUG is forced to false by docker-compose.prod.yml. Do not set true in prod.

# ── System ────────────────────────────────────────────────────
SYSTEM_USER_ID=00000000-0000-0000-0000-000000000000
