# Core Accounting — production environment
#
# One-command install (generates a private .env and starts the stack):
#   ./scripts/install.sh
#
# Manual install:
#   cp .env.example .env
#   # Replace every CHANGE_ME / placeholder below. Do not commit .env.
#   docker compose -f docker-compose.prod.yml up -d --build
#
# docker-compose.prod.yml reads this file for Compose interpolation and injects
# it into the API and Celery containers. DATABASE_URL, AI_READONLY_DATABASE_URL,
# REDIS_URL, DEBUG, and ENVIRONMENT are set by Compose (the API talks to the
# hostnames "db" and "redis" on the internal network).
#
# Passwords are interpolated into URLs. Use hex secrets (openssl rand -hex 32)
# so values do not contain $, quotes, or spaces.

# ── Database (Postgres service) ───────────────────────────────
DB_USER=accounting
DB_PASSWORD=CHANGE_ME
DB_NAME=core_accounting

# AI read-only role. Created on startup by the API container.
# Must not be CHANGE_ME. The role receives SELECT only.
DB_RO_USER=accounting_ro
DB_RO_PASSWORD=CHANGE_ME

# ── Published ports ───────────────────────────────────────────
# Web UI + /api are served together by Nginx (same origin).
NGINX_PORT=80
# Direct API port. Optional for operators; the UI does not need it.
BACKEND_PORT=8000

# ── Public origin ─────────────────────────────────────────────
# Browser origin of the UI. Production startup REFUSES localhost and 127.0.0.1.
# Use the host users actually open, for example http://203.0.113.10 or
# https://accounting.example.com (when a TLS proxy sits in front).
# Same-origin UI traffic does not send a CORS preflight; this value still has
# to pass startup checks and is the allow-list for any cross-origin client.
PUBLIC_URL=http://your-server.example.com
CORS_ORIGINS=["http://your-server.example.com"]

# ── JWT ───────────────────────────────────────────────────────
# REQUIRED. openssl rand -hex 32
# The placeholder below is rejected when ENVIRONMENT=production.
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_USE_A_STRONG_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=1

# Applied only when the admin user is first created. Re-runs do not reset it.
# Minimum 6 characters. Change the password in the UI after the first login.
INITIAL_ADMIN_PASSWORD=admin123

# ── DeepSeek / LLM (optional — AI features) ───────────────────
# https://platform.deepseek.com/api_keys
# Leave the placeholder to boot without AI (a warning is logged).
DEEPSEEK_API_KEY=sk-CHANGE_ME
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_FALLBACK_MODEL=deepseek-chat

# ── Aliyun OCR / 票据识别 (optional) ───────────────────────────
# https://ram.console.aliyun.com/manage/ak — grant OCR permissions.
# Leave empty to use the rule-based fallback instead of cloud OCR.
ALIYUN_OCR_ACCESS_KEY_ID=
ALIYUN_OCR_ACCESS_KEY_SECRET=
ALIYUN_OCR_ENDPOINT=ocr-api.cn-hangzhou.aliyuncs.com

# ── Pool / limits / app ───────────────────────────────────────
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

RATE_LIMIT_GLOBAL=60/minute
RATE_LIMIT_AI=10/minute
RATE_LIMIT_AUTH=5/minute

APP_NAME=Core Accounting
APP_VERSION=0.1.0

SYSTEM_USER_ID=00000000-0000-0000-0000-000000000000
